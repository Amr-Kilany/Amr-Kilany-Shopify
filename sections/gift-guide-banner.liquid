{{ 'gift-guide.css' | asset_url | stylesheet_tag }}

<section
  class="gift-banner"
  {% if section.settings.background != blank %}
    style="background-image:url('{{ section.settings.background | image_url: width: 2000 }}')"
  {% endif %}
>
  <div class="page-width">

    <div class="gift-banner__content">

      {% if section.settings.eyebrow != blank %}
        <span class="gift-banner__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      <h1 class="gift-banner__heading">
        {{ section.settings.heading }}
      </h1>

      <div class="gift-banner__description">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.button_link }}"
        class="gift-banner__button"
      >
        {{ section.settings.button_text }}
      </a>

    </div>

  </div>
</section>